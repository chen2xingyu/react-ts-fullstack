{
  "name": "react-ts-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/main.ts",
    "dev:server:legacy": "npm --prefix server run dev",
    "dev:all": "concurrently -k -n SERVER,WEB -c blue,green \"npm:dev:server\" \"npm:dev\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx server/ts/scripts/migrate.ts",
    "db:seed": "tsx server/ts/scripts/seed.ts",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.52.0",
    "axios": "^1.7.7",
    "dotenv": "^18.0.5",
    "helmet": "^8.3.0",
    "lightweight-charts": "^5.2.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prismjs": "^1.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^6.26.0",
    "react-simple-code-editor": "^0.14.1",
    "zod": "^4.6.5",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^26.6.4",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^10.0.5",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.9",
    "jsdom": "^30.1.2",
    "postcss": "^8.4.40",
    "prettier": "^3.3.3",
    "supertest": "^7.3.1",
    "tailwindcss": "^3.4.7",
    "tsx": "^4.23.15",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.4.1",
    "vitest": "^2.1.9"
  }
}
