NODE_ENV=development
PORT=3000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=react_ts_db

# Redis（可选，默认 localhost:6379/0）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# JWT 密钥（可选，有默认值；生产环境务必修改）
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production

CORS_ORIGIN=http://localhost:5173

# 交易参数（可选，有默认值）
TRADING_FEE_RATE=0.0003
TRADING_DEFAULT_CASH=1000000
SIMULATE_ALL_DAY=true

# Python 解释器路径（Python 运行器页面用；指向装了 akshare/pandas 的 python）
# Windows 示例：C:\Users\xxx\AppData\Local\Programs\Python\Python313\python.exe
# 若 python 已在 PATH，填 python 即可
PYTHON_PATH=python
